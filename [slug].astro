---
import Layout from '../../layouts/Layout.astro';
import { apps, site } from '../../data/apps.js';

export function getStaticPaths() {
  return apps.map((app, i) => ({
    params: { slug: app.slug },
    props: { app, rank: i + 1 },
  }));
}

const { app, rank } = Astro.props;
---

<Layout
  title={`${app.name} Review — Is It Worth It? | ${site.name}`}
  description={app.description}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a href="/" class="text-sm text-ink-muted hover:text-rose transition-colors">&larr; Back to rankings</a>

    <div class="flex items-center gap-2 mt-6">
      <span class="text-rose font-display font-bold text-sm">Rank #{rank}</span>
      <span class="text-ink-faint">·</span>
      <span class="text-ink-muted text-sm">Rated {app.rating}/10</span>
    </div>

    <h1 class="font-display font-extrabold text-3xl sm:text-4xl mt-3">{app.name} Review</h1>
    <p class="text-ink-muted mt-2">{app.tagline}</p>

    <img
      src={`/images/${app.image}`}
      alt={app.name}
      class="w-full rounded-2xl border border-border mt-8"
      loading="eager"
      decoding="async"
    />

    <p class="text-ink-muted leading-relaxed mt-8 text-lg">{app.description}</p>

    <h2 class="font-display font-bold text-xl mt-10 mb-4">Key features</h2>
    <ul class="space-y-2">
      {app.features.map((f) => (
        <li class="flex items-center gap-3 text-ink-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
          {f}
        </li>
      ))}
    </ul>

    <a
      href={app.affiliateUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="inline-block mt-10 bg-rose hover:bg-rose-dim text-void font-semibold py-3.5 px-10 rounded-xl transition-colors"
    >
      Try {app.name} now
    </a>
  </article>
</Layout>
