---
interface Props {
  rank: number;
  slug: string;
  name: string;
  tagline: string;
  description: string;
  image: string;
  affiliateUrl: string;
  features: string[];
}

const { rank, slug, name, tagline, description, image, affiliateUrl, features } = Astro.props;
const isTop = rank === 1;
const rankLabel = String(rank).padStart(2, '0');
---

<article
  class:list={[
    'relative flex flex-col sm:flex-row gap-6 rounded-2xl border p-6 sm:p-7 transition-colors',
    isTop
      ? 'bg-surface-raised border-rose/60'
      : 'bg-surface border-border hover:border-border-strong',
  ]}
>
  <!-- rank numeral -->
  <div
    class:list={[
      'font-display font-extrabold leading-none select-none shrink-0 text-4xl sm:text-5xl',
      isTop ? 'text-rose' : 'text-ink-faint',
    ]}
    aria-hidden="true"
  >
    {rankLabel}
  </div>

  <!-- image -->
  <a
    href={affiliateUrl}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="block w-full sm:w-40 h-40 shrink-0 rounded-xl overflow-hidden bg-surface-raised border border-border"
  >
    <img
      src={`/images/${image}`}
      alt={name}
      loading={isTop ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover"
    />
  </a>

  <!-- content -->
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <div>
        <h2 class="font-display font-bold text-xl text-ink">
          <a href={`/reviews/${slug}`} class="hover:text-rose transition-colors">{name}</a>
        </h2>
        <p class="text-sm text-ink-muted mt-0.5">{tagline}</p>
      </div>
      {isTop && (
        <span class="shrink-0 text-xs font-medium tracking-wide bg-rose/15 text-rose border border-rose/40 rounded-full px-3 py-1">
          Editor's pick
        </span>
      )}
    </div>

    <p class="text-sm text-ink-muted mt-3 leading-relaxed max-w-prose">{description}</p>

    <div class="flex flex-wrap gap-2 mt-4">
      {features.map((f) => (
        <span class="text-xs bg-surface-raised border border-border text-ink-muted rounded-full px-3 py-1">
          {f}
        </span>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row gap-3 mt-5">
      <a
        href={affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="text-center bg-rose hover:bg-rose-dim text-void font-semibold py-2.5 px-6 rounded-lg transition-colors"
      >
        Visit {name}
      </a>
      <a
        href={`/reviews/${slug}`}
        class="text-center bg-transparent hover:bg-surface-raised border border-border text-ink font-semibold py-2.5 px-6 rounded-lg transition-colors"
      >
        Read full review
      </a>
    </div>
  </div>
</article>
