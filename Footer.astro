---
import { site } from '../data/apps.js';
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-ink-faint space-y-3">
    <p>
      18+ only. This site contains links to adult content and is intended
      for adult audiences.
    </p>
    <p>
      {site.name} may earn a commission when you sign up through links on
      this page — see our <a href="/disclosure" class="text-ink-muted underline hover:text-rose">affiliate disclosure</a>.
      Rankings reflect our own editorial review and may change over time.
    </p>
    <p>&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
