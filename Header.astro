    <nav class="flex items-center gap-6 text-sm text-ink-muted">
      <a href="/" class="hover:text-ink transition-colors">Rankings</a>
      <a href="/disclosure" class="hover:text-ink transition-colors">Disclosure</a>
    </nav>
  </div>
</header>
